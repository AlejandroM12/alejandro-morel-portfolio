generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  concept
  in_progress
  shipped
}

enum ProjectCategory {
  web
  backend
  mobile
  applied_ai
}

model Profile {
  slug         String   @id
  name         String
  jobTitle     Json
  technologies Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model Contact {
  id        String   @id @default("default")
  email     String   @default("")
  linkedin  String   @default("")
  cvUrl     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

model Experience {
  slug         String   @id
  organization String
  role         Json
  period       String   @default("")
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("experiences")
}

model SkillGroup {
  slug      String   @id
  label     Json
  items     Json
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skill_groups")
}

model Project {
  slug          String            @id
  name          String
  status        ProjectStatus
  featured      Boolean           @default(false)
  order         Int
  categories    ProjectCategory[]
  technologies  String[]
  languages     String[]
  summary       Json
  overview      Json
  problem       Json
  solution      Json
  features      Json
  architecture  Json
  decisions     Json
  screenshots   Json
  demoUrl       String            @default("")
  repositoryUrl String            @default("")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("projects")
}
